			<xs:documentation>Invoice Number</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:AN25Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SubInvoiceIssueDate" type="IATABDT:DTBase">
		<xs:annotation>
			<xs:documentation>InvoiceDate </xs:documentation>
		</xs:annotation>
	</xs:element>
