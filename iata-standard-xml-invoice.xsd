			<xs:documentation>ISO Standard Currency Code Use IATA Codes, Section C </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceCurrencyCodeLocal" type="IATAFC:CurrencyCodeBase">
		<xs:annotation>
			<xs:documentation>Local Currency Code (Standard ISO Code)</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceCurrencyConversion">
