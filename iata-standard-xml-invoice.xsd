			<xs:sequence>
				<xs:element ref="SubInvoiceNumber" minOccurs="0"/>
				<xs:element ref="SubInvoiceIssueDate" minOccurs="0"/>
				<xs:element ref="SubInvoiceCurrencyCode" minOccurs="0"/>
				<xs:element ref="SubInvoiceCurrencyCodeLocal" minOccurs="0"/>
				<xs:element ref="SubInvoiceCurrencyConversion" minOccurs="0"/>
				<xs:element ref="SubInvoiceTotalAmount" minOccurs="0"/>
				<xs:element ref="SubInvoiceTotalAmountLocal" minOccurs="0"/>
