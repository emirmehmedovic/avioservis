		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceTotalAmountLocal" type="IATABDT:D182Base">
		<xs:annotation>
			<xs:documentation>Total Amount Due on the affiliate Invoice in local currency.</xs:documentation>
		</xs:annotation>
	</xs:element>
