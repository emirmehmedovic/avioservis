			<xs:documentation>Reference Date Attribute: Invoice Date for tax point date, service period start, end dates, delivery ticket date Use IATA Codes, Section N </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="IATABDT:DTBase">
					<xs:attribute ref="ItemReferenceDateTypes" use="required"/>
