			<xs:sequence>
				<xs:element ref="SubInvoiceIDVATRegistrationNumber"/>
				<xs:element ref="SubInvoiceIDName1"/>
				<xs:element ref="SubInvoiceIDName2" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDStreet1" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDStreet2" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDCity" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDState" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDCountryCode" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDPostalCode" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDCustomField" minOccurs="0" maxOccurs="99"/>
			</xs:sequence>
			<xs:attribute name="SubInvoiceIDType" type="IATAFC:InvoiceIDType" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="SubInvoiceIDVATRegistrationNumber" type="IATABDT:AN25Base">
		<xs:annotation>
			<xs:documentation>VAT or Other Tax Registration Number</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDName1" type="IATABDT:AN50Base">
		<xs:annotation>
			<xs:documentation>Name related to the Invoice ID Type</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDName2" type="IATABDT:AN50Base">
		<xs:annotation>
			<xs:documentation>Additonal name related to InvoiceIDType</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDStreet1" type="IATABDT:AN50Base">
		<xs:annotation>
			<xs:documentation>Street Address</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDStreet2" type="IATABDT:AN50Base">
		<xs:annotation>
			<xs:documentation>Street Address</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDCity" type="IATABDT:AN50Base">
		<xs:annotation>
			<xs:documentation>City</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDState" type="IATABDT:AN50Base">
		<xs:annotation>
			<xs:documentation>State/Province/Region/County</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDCountryCode" type="IATAFC:CountryCode">
		<xs:annotation>
			<xs:documentation>Country Code Use IATA Codes, Section G </xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDPostalCode">
		<xs:annotation>
			<xs:documentation>Postal Code</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="9"/>
				<xs:minLength value="1"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SubInvoiceIDCustomField">
		<xs:annotation>
			<xs:documentation>Custom Field Attribute: Counter for the nodes. </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SubInvoiceIDCustomFieldDescription" minOccurs="0"/>
				<xs:element ref="SubInvoiceIDCustomFieldValue"/>
			</xs:sequence>
			<xs:attribute name="SubInvoiceIDCustomFieldNumber" use="required">
				<xs:annotation>
					<xs:documentation>Sort order of custom fields.</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:integer">
						<xs:minInclusive value="1"/>
						<xs:maxInclusive value="99"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="SubInvoiceIDCustomFieldDescription" type="IATABDT:AN35Base">
		<xs:annotation>
			<xs:documentation>Description of CustomField</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceIDCustomFieldValue" type="IATABDT:AN35Base">
		<xs:annotation>
			<xs:documentation>Value of CustomField</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceTaxes">
		<xs:annotation>
			<xs:documentation>Header Level tax detail</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SubInvoiceTaxDetail" maxOccurs="200"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="SubInvoiceTaxDetail">
		<xs:annotation>
			<xs:documentation>Tax Detail Header, one per tax type.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="SubInvoiceTaxDetailType"/>
				<xs:element ref="SubInvoiceTaxDetailDescription" minOccurs="0"/>
				<xs:element ref="SubInvoiceTaxDetailRate"/>
				<xs:element ref="SubInvoiceTaxDetailAmount"/>
				<xs:element ref="SubInvoiceTaxDetailAmountLocal" minOccurs="0"/>
				<xs:element ref="SubInvoiceTaxIndicator"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="SubInvoiceTaxDetailType" type="IATAFC:TaxTypeBase">
		<xs:annotation>
			<xs:documentation>Type of Tax Use IATA Codes, Section F</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceTaxDetailRate">
		<xs:annotation>
			<xs:documentation>Tax Rate as Decimal</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:D186Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SubInvoiceTaxDetailDescription">
		<xs:annotation>
			<xs:documentation>Tax Description OR Tax in Local Currency</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:AN80Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SubInvoiceTaxDetailAmount">
		<xs:annotation>
			<xs:documentation>Amount of Invoice Tax in Invoice Currency</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:D182Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SubInvoiceTaxDetailAmountLocal" type="IATABDT:D182Base">
		<xs:annotation>
			<xs:documentation>Amount of tax in local currency.</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubInvoiceTaxIndicator">
		<xs:annotation>
			<xs:documentation>Official Posting (O) or For Info Only (I)</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="O"/>
				<xs:enumeration value="I"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="SubInvoiceFootNotes">
		<xs:annotation>
			<xs:documentation>Free Form text</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="200"/>
				<xs:minLength value="1"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="InvoiceLine">
		<xs:annotation>
			<xs:documentation>Invoice Line Information, one for each line on the invoice</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ItemNumber"/>
				<xs:element ref="ItemQuantity" maxOccurs="2"/>
				<xs:element name="ItemDeliveryReferenceValue" minOccurs="0" maxOccurs="20"/>
				<xs:element ref="ItemTaxInvoiceNumber" minOccurs="0"/>
				<xs:element ref="ItemDeliveryLocation" minOccurs="0"/>
				<xs:element ref="ItemTransportation" minOccurs="0" maxOccurs="unbounded"/>
				<xs:element ref="ItemReferenceLocalDate" maxOccurs="10"/>
				<xs:element ref="ItemReferenceGMTDate" minOccurs="0" maxOccurs="10"/>
				<xs:element ref="ItemDescription" minOccurs="0"/>
				<xs:element ref="ItemInvoiceAmount"/>
				<xs:element ref="ItemInvoiceAmountLocal" minOccurs="0"/>
				<xs:element ref="SubItem"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ItemNumber">
		<xs:annotation>
			<xs:documentation>Serial line item number</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:integer">
				<xs:minInclusive value="1"/>
				<xs:maxInclusive value="999999"/>
				<xs:totalDigits value="6"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemQuantity">
		<xs:annotation>
			<xs:documentation>Node for quantity information</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ItemQuantityType"/>
				<xs:element ref="ItemQuantityFlag"/>
				<xs:element ref="DensityInformation" minOccurs="0"/>
				<xs:element ref="ItemQuantityQty"/>
				<xs:element ref="ItemQuantityUOM"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="DensityInformation">
		<xs:annotation>
			<xs:documentation>Information relating to the parameters used to correct the volume to its net amount</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Density" minOccurs="0"/>
				<xs:element ref="Temperature" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute name="DensityType" type="IATAFC:DensityType" use="required"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Density">
		<xs:annotation>
			<xs:documentation>Density of fuel</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="IATABDT:D184Base">
					<xs:attribute name="DensityUOM" type="IATAFC:VUOMBase" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="Temperature">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="IATABDT:D41Base">
					<xs:attribute name="TUOM" type="IATAFC:TUOM" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ItemQuantityType">
		<xs:annotation>
			<xs:documentation>delivered quantity (always)</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="DL"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemQuantityFlag" type="IATAFC:BaseBasis">
		<xs:annotation>
			<xs:documentation>Gross or Net quantity</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ItemQuantityQty">
		<xs:annotation>
			<xs:documentation>Quantity of product or service</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:D186Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemQuantityUOM" type="IATAFC:PUOMBase">
		<xs:annotation>
			<xs:documentation>Unit of measure</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ItemDeliveryReferenceValue">
		<xs:annotation>
			<xs:documentation>Reference Value. Attribute: Reference type such as contract number, po number, flight number Use IATA Codes, Section Q</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="IATABDT:AN25Base">
					<xs:attribute name="ItemDeliveryReferenceType" type="IATAFC:ItemReferenceCode" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ItemTaxInvoiceNumber">
		<xs:annotation>
			<xs:documentation>Tax Number for the line item</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:AN25Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemDeliveryLocation" type="IATABDT:AN20Base">
		<xs:annotation>
			<xs:documentation>Delivery location of goods or services. REQUIRED if 'MULTIPLE' is selected in InvoiceDeliveryLocation</xs:documentation>
		</xs:annotation>
	</xs:element>
