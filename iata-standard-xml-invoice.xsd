<xs:schema xmlns:IATAFC="http://www.IATA.com/IATA_FUEL_CodeDirectory" xmlns:IATABDT="http://www.IATA.com/IATA_FUEL_BaseDataTypeDirectory" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified" version="3.2.1">
	<xs:import namespace="http://www.IATA.com/IATA_FUEL_CodeDirectory" schemaLocation="IATA_FUEL_CodeDirectory.xsd"/>
	<xs:import namespace="http://www.IATA.com/IATA_FUEL_BaseDataTypeDirectory" schemaLocation="IATA_FUEL_BaseDataTypeDirectory.xsd"/>
