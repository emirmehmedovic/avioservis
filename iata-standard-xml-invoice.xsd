			<xs:sequence>
				<xs:element ref="ItemTransportationRouting" minOccurs="0"/>
				<xs:element ref="ItemTransportationReferenceCode" minOccurs="0"/>
				<xs:element ref="ItemTransportationReferenceValue" minOccurs="0"/>
				<xs:element ref="ItemTransportationAmount" minOccurs="0"/>
			</xs:sequence>
			<xs:attribute ref="ItemTransportationType"/>
		</xs:complexType>
	</xs:element>
	<xs:attribute name="ItemTransportationType" type="IATAFC:TransportationType">
		<xs:annotation>
			<xs:documentation>Transportation or carrier type.</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:element name="ItemTransportationRouting">
		<xs:annotation>
			<xs:documentation>Description on transportation routing or carrier name</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:AN35Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemTransportationReferenceCode">
