	<xs:element name="ItemTransportationReferenceValue">
		<xs:annotation>
			<xs:documentation>Reference Value</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:AN35Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemTransportationAmount">
