		<xs:annotation>
			<xs:documentation>Code indicating invoice dates for Tax Point Date, service period start, end dates.</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:element name="ItemReferenceGMTDate">
		<xs:annotation>
			<xs:documentation>Reference Date Attribute: Invoice Date for tax point date, service period start, end dates, delivery ticket dateUse IATA Codes, Section N </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="IATABDT:DTBase">
					<xs:attribute ref="ItemReferenceGMTDateTypes" use="required"/>
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:attribute name="ItemReferenceGMTDateTypes" type="IATAFC:ItemReferenceDateType">
		<xs:annotation>
			<xs:documentation>Invoice dates for Tax Point Date, Service Period, Start, end dates delivery ticket dates.</xs:documentation>
		</xs:annotation>
	</xs:attribute>
	<xs:element name="ItemDescription">
		<xs:annotation>
			<xs:documentation>Description of part, product or service</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:AN80Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemInvoiceAmount">
		<xs:annotation>
			<xs:documentation>Line item invoice amount</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="IATABDT:D182Base"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ItemInvoiceAmountLocal" type="IATABDT:D182Base">
